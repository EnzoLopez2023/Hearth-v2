NODE_ENV=development
PORT=3000
DB_PATH=hearth-v2.db
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=developer@hearth.local
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_AUDIENCE=<application-client-id>
# OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# ENTRA_TENANT_ID=<user-facing-tenant-id>
# ENTRA_CLIENT_ID=<application-client-id>
# ENTRA_API_SCOPE=api://<application-client-id>/access_as_user
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# WEATHER_API_KEY=
# WEATHER_BASE_URL=https://api.openweathermap.org
# Development only:
# BLOB_PROVIDER=local
# LOCAL_BLOB_PATH=storage/blobs
# Production durable storage:
# BLOB_PROVIDER=azure
# Passwordless managed identity:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# Compatibility fallback:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=hearth-v2
BUILD_VERSION=dev
SOURCE_SHA=unknown
BUILD_TIME=unknown
BUILD_ID=local
