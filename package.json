{
  "name": "hearth-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "bump:patch": "node scripts/version.mjs patch",
    "bump:minor": "node scripts/version.mjs minor",
    "bump:major": "node scripts/version.mjs major",
    "dev": "concurrently --kill-others \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env DEV_AUTH_ENABLED=true tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json --noEmit && node scripts/build-client.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "legacy:import": "tsx src/server/legacy/cli.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/msal-browser": "^5.20.0",
    "@azure/storage-blob": "^12.33.0",
    "@fontsource/inter": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.7",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
